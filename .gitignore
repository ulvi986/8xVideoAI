# Secrets — never commit. Quoted patterns do NOT work in .gitignore:
# git reads the quote marks as literal characters, so ".env" matched
# nothing and left the real .env exposed.
.env
.env.local
.env.*.local

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.vite/

# Runtime artefacts
*.log
.DS_Store

# Generated media (large binaries; regenerate instead of committing)
server/storage/

# Local database — contains real user rows and password hashes
server/data/

# Tooling caches created during the build (hundreds of MB)
.npm-cache/
.playwright/

.vercel
.env*
