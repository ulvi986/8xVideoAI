# 8xBuildAI server configuration. Copy to server/.env and fill in.
# The repo-root .env is also read, so either location works.

# --- provider -------------------------------------------------------
# Without this, gemini-backed models report themselves unavailable and the
# local ffmpeg simulator serves every generation.
GEMINI_API_KEY=

# --- server ---------------------------------------------------------
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Set this in any real deployment. Without it sessions reset on restart.
SESSION_SECRET=

# --- behaviour ------------------------------------------------------
JOB_CONCURRENCY=2
PROVIDER_TIMEOUT_MS=300000
STARTING_CREDITS=10
ALLOW_SIMULATOR=true

# Only needed if ffmpeg is not on PATH.
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe

# --- prompt rewriting (Azure OpenAI) ---------------------------------
# Used only to rewrite prompts, never to generate media. Without these the
# "Enhance prompt" button is hidden and generation is unaffected.
AZURE_OPENAI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_MODEL=
AZURE_OPENAI_API_VERSION=2024-10-21
LLM_TIMEOUT_SECONDS=60
